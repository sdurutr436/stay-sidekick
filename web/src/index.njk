---
layout: base.njk
title: Inicio
description: Stay Sidekick — La plataforma SaaS para gestionar alojamientos turísticos.
---
{% import "macros/atoms.njk" as atoms %}
{% import "macros/molecules.njk" as molecules %}
{% import "macros/organisms.njk" as organisms %}

{# ─────────────────────────────────────────────────────────────────────────────
   Datos compartidos: las 5 herramientas del showcase.
   Mismo set se usa para el fondo del hero (small, 25% opacidad) y el
   carrusel inferior (small clickable → lightbox con la variante big).
   ───────────────────────────────────────────────────────────────────────────── #}
{% set tools = [
  { key: 'mapa-calor',              folder: 'mapa-calor',              name: 'mapa-calor',              caption: 'Mapa de calor de ocupación' },
  { key: 'sincronizador-contactos', folder: 'sincronizador-contactos', name: 'sincronizador-contactos', caption: 'Sincronizador de contactos' },
  { key: 'notificaciones-tardias',  folder: 'notificaciones',          name: 'notificaciones',          caption: 'Notificaciones tardías' },
  { key: 'vault-comunicaciones',    folder: 'vault-comunicaciones',    name: 'vault-comunicaciones',    caption: 'Vault de comunicaciones' },
  { key: 'maestro-apartamentos',    folder: 'maestro-apartamentos',    name: 'maestro-apartamentos',    caption: 'Maestro de apartamentos' }
] %}

{# § 1 — HERO con carrusel animado de fondo #}
<section class="hero" aria-labelledby="hero-heading">

  {# Fondo: dos tracks (light/dark) animados horizontalmente. Decorativo. #}
  <div class="hero__bg" aria-hidden="true">
    {% for variant in ['light', 'dark'] %}
      {% set imgVariant = 'light-mode' if variant == 'light' else 'dark' %}
      <div class="hero__bg-track hero__bg-track--{{ variant }}">
        {# Duplicamos la lista para que el bucle de translateX(-50%) sea seamless #}
        {% for repeat in [1, 2] %}
          {% for tool in tools %}
            <picture class="hero__bg-item">
              <source
                type="image/webp"
                srcset="/assets/img/paginas/{{ tool.folder }}/stay-sidekick-{{ tool.name }}-{{ imgVariant }}-small.webp">
              <img
                src="/assets/img/paginas/{{ tool.folder }}/stay-sidekick-{{ tool.name }}-{{ imgVariant }}-small.png"
                alt=""
                width="640"
                height="327"
                loading="lazy"
                decoding="async">
            </picture>
          {% endfor %}
        {% endfor %}
      </div>
    {% endfor %}
  </div>

  <div class="hero__inner l-container">
    <h1 id="hero-heading" class="hero__title">Gestiona tu alojamiento sin fricción</h1>
    <p class="hero__subtitle">Stay Sidekick centraliza las herramientas que necesitas para operar de forma autónoma: contactos, ocupación, comunicaciones y solicitudes, todo en un solo lugar.</p>
    <div class="l-flex l-flex--center l-flex--gap-3">
      {{ atoms.button('Presentar solicitud', '/solicitud/', 'primary', 'lg') }}
      {{ atoms.button('Ver funcionalidades', '/producto/funcionalidades/', 'secondary', 'lg') }}
    </div>
  </div>
</section>

{# § 2 — SEPARADOR #}
<hr class="landing-divider" aria-hidden="true" />

{# § 3 — HERRAMIENTAS #}
<section class="tools-showcase l-container" aria-labelledby="tools-heading">
  <h2 id="tools-heading" class="tools-showcase__title">Herramientas pensadas para tu operativa</h2>
  <p class="tools-showcase__desc">Explora en acción cada una de las funcionalidades incluidas en Stay Sidekick.</p>
  <span class="sr-only">Esta sección contiene un carrusel con desplazamiento horizontal. Usa las teclas de flecha para navegar entre los elementos. Pulsa una miniatura para verla ampliada.</span>
  <ul class="tools-showcase__carousel">
    {% for tool in tools %}
      <li class="tools-showcase__item">
        <button
          class="tools-showcase__thumb"
          type="button"
          data-tool-thumb
          data-tool-key="{{ tool.key }}"
          data-tool-folder="{{ tool.folder }}"
          data-tool-name="{{ tool.name }}"
          data-tool-caption="{{ tool.caption }}"
          aria-label="Ampliar captura: {{ tool.caption }}">
          <picture class="tools-showcase__thumb-img tools-showcase__thumb-img--light">
            <source
              type="image/webp"
              srcset="/assets/img/paginas/{{ tool.folder }}/stay-sidekick-{{ tool.name }}-light-mode-small.webp">
            <img
              src="/assets/img/paginas/{{ tool.folder }}/stay-sidekick-{{ tool.name }}-light-mode-small.png"
              alt="{{ tool.caption }}"
              width="640"
              height="327"
              loading="lazy"
              decoding="async">
          </picture>
          <picture class="tools-showcase__thumb-img tools-showcase__thumb-img--dark">
            <source
              type="image/webp"
              srcset="/assets/img/paginas/{{ tool.folder }}/stay-sidekick-{{ tool.name }}-dark-small.webp">
            <img
              src="/assets/img/paginas/{{ tool.folder }}/stay-sidekick-{{ tool.name }}-dark-small.png"
              alt=""
              aria-hidden="true"
              width="640"
              height="327"
              loading="lazy"
              decoding="async">
          </picture>
        </button>
        <p class="tools-showcase__caption">{{ tool.caption }}</p>
      </li>
    {% endfor %}
  </ul>
</section>

{# § 4 — SEPARADOR #}
<hr class="landing-divider" aria-hidden="true" />

{# § 5 — CLIENTES #}
<section class="clients l-container" aria-labelledby="clients-heading">
  <h2 id="clients-heading" class="clients__title">Alojamientos que confían en Stay Sidekick</h2>
  <ul class="clients__grid" role="list">

    <li role="listitem">
      {% call molecules.card() %}
        <figure class="clients__logo-wrapper">
          <picture>
            <source srcset="/assets/img/empresas/Cadiz4Rentals-Gestion-800x800-1-244x300.webp" type="image/webp">
            <img src="/assets/img/empresas/Cadiz4Rentals-Gestion-800x800-1-244x300.png"
                 alt="Logotipo de Cadiz 4 Rentals"
                 width="244" height="300" loading="lazy" />
          </picture>
        </figure>
        <h3 class="clients__name">Cadiz 4 Rentals</h3>
        <span class="clients__location">Cádiz, España</span>
      {% endcall %}
    </li>

    <li role="listitem">
      {% call molecules.card() %}
        <figure class="clients__logo-wrapper">
          <picture>
            <source srcset="/assets/img/empresas/AV-800x800-1-244x300.webp" type="image/webp">
            <img src="/assets/img/empresas/AV-800x800-1-244x300.png"
                 alt="Logotipo de Alquiler Vacacional Cádiz"
                 width="244" height="300" loading="lazy" />
          </picture>
        </figure>
        <h3 class="clients__name">Alquiler Vacacional Cádiz</h3>
        <span class="clients__location">Cádiz, España</span>
      {% endcall %}
    </li>

    <li role="listitem">
      {% call molecules.card() %}
        <figure class="clients__logo-wrapper">
          <picture>
            <source srcset="/assets/img/empresas/AC-Gestion-800x800-1-244x300.webp" type="image/webp">
            <img src="/assets/img/empresas/AC-Gestion-800x800-1-244x300.png"
                 alt="Logotipo de AC-Gestión"
                 width="244" height="300" loading="lazy" />
          </picture>
        </figure>
        <h3 class="clients__name">AC-Gestión</h3>
        <span class="clients__location">Cádiz, España</span>
      {% endcall %}
    </li>

  </ul>
</section>

{# § 6 — SEPARADOR #}
<hr class="landing-divider" aria-hidden="true" />

{# § 7 — CTA FINAL #}
<section class="landing-cta l-container u-text-center" aria-labelledby="cta-heading">
  <h2 id="cta-heading" class="landing-cta__title">Empieza a trabajar de forma más inteligente</h2>
  <p class="landing-cta__desc">Únete a los alojamientos que ya gestionan sus operaciones con Stay Sidekick. El acceso es por solicitud.</p>
  {{ atoms.button('Presentar solicitud', '/solicitud/', 'primary', 'lg') }}
  <p class="landing-cta__note">Sin permanencia. Sin tarjeta de crédito.</p>
</section>

{# § 8 — LIGHTBOX (oculto por defecto; JS lo abre con la herramienta seleccionada) #}
<div
  class="lightbox"
  data-lightbox
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="lightbox-caption">
  <button
    class="lightbox__close"
    type="button"
    data-lightbox-close
    aria-label="Cerrar captura ampliada">
    <svg viewBox="0 0 256 256" fill="currentColor" width="28" height="28" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"/>
    </svg>
  </button>
  <figure class="lightbox__figure">
    <div class="lightbox__image" data-lightbox-slot></div>
    <figcaption class="lightbox__caption" id="lightbox-caption" data-lightbox-caption></figcaption>
  </figure>
</div>

{% block scripts %}
<script src="/assets/js/landing-lightbox.js" defer></script>
{% endblock %}
