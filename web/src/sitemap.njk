---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{#
  PAGE: /sitemap.xml (sitemap estático para indexación SEO)
  Propósito  : exponer las URLs públicas con su `changefreq` y `priority` para
               que motores de búsqueda las descubran y prioricen.
  Datos      : `site.url` (origen canónico) — el resto de URLs son fijas.
  Cuidado    : `eleventyExcludeFromCollections: true` evita que el sitemap se
               cuele en otras colecciones; si añades una página pública nueva,
               hay que listarla aquí a mano (no es auto-generado).
#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ site.url }}/producto/funcionalidades/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>{{ site.url }}/precios/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>{{ site.url }}/empresa/sobre-nosotros/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>{{ site.url }}/empresa/contacto/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>{{ site.url }}/legal/privacidad/</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>{{ site.url }}/legal/terminos/</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>{{ site.url }}/legal/cookies/</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
